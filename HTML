<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Administrativo IPTV</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        :root { --primaria: #1a1a2e; --secundaria: #16213e; --destaque: #0f3460; --verde: #00d9a5; --texto: #e6e6e6; }
        body { background: var(--primaria); color: var(--texto); min-height: 100vh; }

        .cabecalho { background: var(--secundaria); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid var(--verde); }
        .cabecalho h1 { font-size: 1.5rem; color: var(--verde); }

        .container { display: grid; grid-template-columns: 320px 1fr; gap: 1rem; padding: 1rem; height: calc(100vh - 80px); }

        .painel-lateral { background: var(--secundaria); border-radius: 8px; padding: 1rem; overflow-y: auto; }
        .painel-lateral h2 { font-size: 1rem; margin-bottom: 1rem; color: var(--verde); }

        .form-grupo { margin-bottom: 0.8rem; }
        label { display: block; margin-bottom: 0.3rem; font-size: 0.9rem; }
        input, button { width: 100%; padding: 0.6rem; border: none; border-radius: 4px; font-size: 0.9rem; }
        input { background: var(--destaque); color: #fff; }
        button { background: var(--verde); color: #000; font-weight: bold; cursor: pointer; margin-top: 0.3rem; transition: 0.2s; }
        button:hover { filter: brightness(1.1); }
        .btn-remover { background: #ff4757; color: #fff; }

        .lista-canais { margin-top: 1.2rem; }
        .item-canal { background: var(--destaque); padding: 0.6rem; margin: 0.4rem 0; border-radius: 4px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; }
        .item-canal:hover { background: #194075; }
        .item-canal span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }

        .area-player { background: var(--secundaria); border-radius: 8px; padding: 1rem; display: flex; flex-direction: column; }
        .player-wrapper { flex: 1; background: #000; border-radius: 6px; display: flex; align-items: center; justify-content: center; overflow: hidden; min-height: 400px; }
        video { width: 100%; height: 100%; outline: none; }
        .sem-video { color: #888; text-align: center; }

        .info-canal { margin-top: 0.8rem; padding: 0.6rem; background: var(--destaque); border-radius: 4px; font-size: 0.9rem; }

        @media(max-width: 900px) {
            .container { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <header class="cabecalho">
        <h1>📺 PAINEL ADMINISTRATIVO IPTV</h1>
        <span id="total-canais">0 canais</span>
    </header>

    <div class="container">
        <!-- LATERAL: CADASTRO E LISTA -->
        <aside class="painel-lateral">
            <h2>➕ Adicionar Canal / Lista M3U</h2>

            <div class="form-grupo">
                <label>Nome do Canal:</label>
                <input type="text" id="nome-canal" placeholder="Ex: Globo, SBT...">
            </div>
            <div class="form-grupo">
                <label>URL do Canal (.m3u8 / .ts):</label>
                <input type="url" id="url-canal" placeholder="http://.../stream.m3u8">
            </div>
            <button onclick="adicionarCanal()">ADICIONAR CANAL</button>

            <hr style="margin:1rem 0; border-color:#0f3460;">

            <div class="form-grupo">
                <label>📂 Carregar Lista M3U (arquivo):</label>
                <input type="file" id="arquivo-m3u" accept=".m3u,.m3u8">
            </div>
            <button onclick="carregarM3U()">IMPORTAR LISTA</button>

            <div class="lista-canais">
                <h2>📋 Canais Cadastrados</h2>
                <div id="lista"></div>
                <button class="btn-remover" onclick="limparLista()">LIMPAR TODOS</button>
            </div>
        </aside>

        <!-- DIREITA: PLAYER -->
        <main class="area-player">
            <div class="player-wrapper">
                <video id="player" controls autoplay></video>
                <div id="sem-video" class="sem-video">Selecione um canal para assistir</div>
            </div>
            <div class="info-canal">
                <strong>Canal:</strong> <span id="nome-atual">—</span><br>
                <strong>URL:</strong> <span id="url-atual" style="font-size:0.75rem; word-break:break-all;">—</span>
            </div>
        </main>
    </div>

<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.21/dist/hls.min.js"></script>
<script>
let canais = [];
let hls = null;

// Carregar dados salvos ao abrir
window.onload = () => {
    const salvo = localStorage.getItem('canais-iptv');
    if(salvo) canais = JSON.parse(salvo);
    renderizarLista();
};

function salvar() {
    localStorage.setItem('canais-iptv', JSON.stringify(canais));
}

function adicionarCanal(){
    const nome = document.getElementById('nome-canal').value.trim();
    const url = document.getElementById('url-canal').value.trim();
    if(!nome || !url) { alert('Preencha nome e URL!'); return; }

    canais.push({nome, url});
    salvar();
    renderizarLista();

    document.getElementById('nome-canal').value = '';
    document.getElementById('url-canal').value = '';
}

function carregarM3U(){
    const arq = document.getElementById('arquivo-m3u').files[0];
    if(!arq) return;
    const leitor = new FileReader();
    leitor.onload = e => {
        const texto = e.target.result;
        const linhas = texto.split('\n');
        let nome = '', cont = 0;
        linhas.forEach(l => {
            l = l.trim();
            if(l.startsWith('#EXTINF')){
                nome = l.split(',')[1] || `Canal ${++cont}`;
            } else if(l.startsWith('http')){
                canais.push({nome, url: l});
                nome = '';
            }
        });
        salvar();
        renderizarLista();
        alert(`Importado! Total: ${canais.length} canais`);
    };
    leitor.readAsText(arq);
}

function renderizarLista(){
    const el = document.getElementById('lista');
    el.innerHTML = '';
    canais.forEach((c, i)=>{
        const item = document.createElement('div');
        item.className = 'item-canal';
        item.innerHTML = `<span title="${c.nome}">📡 ${c.nome}</span>
        <div>
            <button style="width:auto; padding:0.2rem 0.5rem; margin:0; background:#ffc107; color:#000;" onclick="event.stopPropagation(); removerCanal(${i})">✕</button>
        </div>`;
        item.onclick = () => reproduzir(c);
        el.appendChild(item);
    });
    document.getElementById('total-canais').textContent = `${canais.length} canais`;
}

function removerCanal(i){
    if(confirm('Remover este canal?')){
        canais.splice(i,1);
        salvar();
        renderizarLista();
    }
}

function limparLista(){
    if(confirm('Remover TODOS os canais?')){
        canais = [];
        salvar();
        renderizarLista();
    }
}

function reproduzir(canal){
    const player = document.getElementById('player');
    document.getElementById('sem-video').style.display = 'none';
    document.getElementById('nome-atual').textContent = canal.nome;
    document.getElementById('url-atual').textContent = canal.url;

    if(hls) hls.destroy();

    if(Hls.isSupported()){
        hls = new Hls();
        hls.loadSource(canal.url);
        hls.attachMedia(player);
        hls.on(Hls.Events.MANIFEST_PARSED, () => player.play());
        hls.on(Hls.Events.ERROR, (e,d)=>{ if(d.fatal) alert('Erro ao reproduzir!'); });
    } else if(player.canPlayType('application/vnd.apple.mpegurl')){
        player.src = canal.url;
    } else {
        player.src = canal.url;
    }
}
</script>
</body>
</html>
